@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

System_Boundary(fraud_context, "Anti-Fraud/Scoring Context") {
  Container(fraud_service, "Anti-Fraud Service", "Kotlin", "Онлайн-проверка\nСкоринг рисков")
  Container(kafka, "Kafka", "Kafka", "Результаты для анализа")

  Container_Boundary(internal, "Внутренние компоненты") {
    Container(engine, "Fraud Engine", "Kotlin", "Ядро проверки")
    Container(scoring, "Scoring Engine", "Kotlin", "Процесс присвоения баллов")
    ContainerDb_Ext(fraud_db, "Fraud Model DB", "Postgres")
  }
}

Rel(fraud_service, fraud_db, "jbdc")
Rel(fraud_service, engine, "Внутренний вызов", "Синхронный")
Rel(fraud_service, scoring, "Внутренний вызов", "Синхронный")
Rel(engine, kafka, "Событие для статистики", "Acинхронный")
Rel(scoring, kafka, "Событие для статистики", "Acинхронный")

@enduml